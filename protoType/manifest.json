{
  "manifest_version": 3,
  "name": "Project-Vision",
  "version": "1.0",
  "description": "Privacy-preserving visual agent running local PII redaction.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["dist/bg.js"],
    "service_worker": "dist/bg.js"
  }
}
