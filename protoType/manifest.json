{
  "manifest_version": 3,
  "name": "Project-Vision",
  "version": "1.0.0",
  "description": "Privacy-preserving visual browser agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
  "service_worker": "dist/bg.js",
  "type": "module"
}
}